#!/bin/sh
# AppImage entry point.
#
# Everything Subordinate needs that is not part of a base distro install lives
# under $APPDIR: the binary, the GStreamer libraries, the plugin modules chosen
# by packaging/linux/gst-plugins.txt and the plugin scanner. The host keeps
# three things only: the graphics driver stack (Mesa/NVIDIA, used by wgpu and
# by the va/nvcodec plugins), the display server and PulseAudio/PipeWire.
#
# POSIX sh on purpose: the AppImage has to start on a system with no bash.
set -eu

here=$(dirname "$(readlink -f "$0")")
libdir=$here/usr/lib

# GStreamer's registry is a cache of absolute paths. The AppImage mounts at a
# different /tmp/.mount_XXXX every run, so a registry from the previous run
# points at a directory that no longer exists; without a private, per-run
# registry file GStreamer either rescans noisily or loads nothing at all.
GST_REGISTRY=${TMPDIR:-/tmp}/subordinate-gst-registry-$$.bin
GST_PLUGIN_SYSTEM_PATH_1_0=$libdir/gstreamer-1.0
GST_PLUGIN_PATH_1_0=$libdir/gstreamer-1.0
GST_PLUGIN_SCANNER=$libdir/gstreamer-1.0/gst-plugin-scanner
export GST_REGISTRY GST_PLUGIN_SYSTEM_PATH_1_0 GST_PLUGIN_PATH_1_0 GST_PLUGIN_SCANNER

# Keep the bundled libraries ahead of the host's, but never in front of the
# driver stack: LD_LIBRARY_PATH is appended to, not prefixed with, whatever the
# caller already set, so a host that points at its own GL/VA drivers wins.
LD_LIBRARY_PATH=$libdir${LD_LIBRARY_PATH:+:$LD_LIBRARY_PATH}
export LD_LIBRARY_PATH

# usr/lib/fallback holds the VA-API and VDPAU dispatchers, which the bundled
# gst-libav, va, qsv and msdk modules all have in DT_NEEDED and which a host is
# entitled not to have installed: when it does not, those plugins are
# blacklisted at scan time and an ordinary H.264/AAC file stops being readable
# (TASK-139/TASK-145). They are staged off the library path because they are
# dispatchers -- they dlopen the host's driver and bind it by a version-stamped
# init symbol -- so a bundled copy in front of the host's would refuse a driver
# built against a newer one and turn working hardware encode into software.
#
# So the choice is made per library, at start-up: link only the sonames this
# machine has no answer for into a shim directory, and leave the rest to the
# host. See packaging/linux/fallback-libs.txt.
if [ -d "$libdir/fallback" ]; then
    shim=${TMPDIR:-/tmp}/subordinate-hostlibs-$(id -u)
    # Recreated every run: a machine that has since installed libva must stop
    # getting the bundled one. A path that is not a directory this user owns
    # (someone else got there first) is stepped around, not written to.
    if [ -e "$shim" ] && { [ ! -d "$shim" ] || [ ! -O "$shim" ]; }; then
        shim=$(mktemp -d "${TMPDIR:-/tmp}/subordinate-hostlibs-XXXXXX" 2>/dev/null || echo "")
    else
        mkdir -p "$shim" 2>/dev/null || shim=""
    fi
    if [ -n "$shim" ]; then
        rm -f "$shim"/*.so.* 2>/dev/null || true
        linked=0
        for lib in "$libdir"/fallback/*.so.*; do
            [ -e "$lib" ] || continue
            soname=${lib##*/}
            found=""
            for dir in /usr/lib/x86_64-linux-gnu /usr/lib64 /usr/lib /lib/x86_64-linux-gnu \
                /lib64 /lib /usr/local/lib/x86_64-linux-gnu /usr/local/lib64 /usr/local/lib; do
                if [ -e "$dir/$soname" ]; then
                    found=$dir/$soname
                    break
                fi
            done
            if [ -z "$found" ] && ln -sf "$lib" "$shim/$soname" 2>/dev/null; then
                linked=$((linked + 1))
            fi
        done
        if [ "$linked" -gt 0 ]; then
            LD_LIBRARY_PATH=$LD_LIBRARY_PATH:$shim
            export LD_LIBRARY_PATH
            if [ -n "${SUB_APPIMAGE_VERBOSE:-}" ]; then
                echo "AppRun: this host has no $(cd "$shim" && echo *); using the bundled copies" >&2
            fi
        fi
    fi
fi

# GIO modules and typelibs would otherwise be looked up in /usr on the host,
# where they may be a different major version than the bundled GLib.
if [ -d "$libdir/gio/modules" ]; then
    GIO_MODULE_DIR=$libdir/gio/modules
    export GIO_MODULE_DIR
fi
XDG_DATA_DIRS=$here/usr/share${XDG_DATA_DIRS:+:$XDG_DATA_DIRS}:/usr/local/share:/usr/share
export XDG_DATA_DIRS

cleanup() {
    rm -f "$GST_REGISTRY"
}
trap cleanup EXIT INT TERM

# SUB_APPIMAGE_TOOL runs a bundled GStreamer command instead of the editor, so
# `./Subordinate-x86_64.AppImage` and
# `SUB_APPIMAGE_TOOL=gst-inspect-1.0 ./Subordinate-x86_64.AppImage va` report on
# the same runtime. That is how the hardware workflow proves the package's own
# encoders exist rather than the host's.
if [ -n "${SUB_APPIMAGE_TOOL:-}" ]; then
    exec "$here/usr/bin/$SUB_APPIMAGE_TOOL" "$@"
fi

# `Subordinate.AppImage --mcp` runs the MCP bridge instead of the editor, so an
# agent's .mcp.json can name the AppImage itself as its `command` -- there is
# no installed path to point at, and the bridge has to start with the bundle's
# environment anyway (it launches subordinate-cli, which needs the same
# GStreamer variables set above). Everything after --mcp goes to the bridge.
# See docs/mcp-guide.md, "Pointing .mcp.json at an installed package".
if [ "${1:-}" = "--mcp" ]; then
    shift
    bridge=$here/usr/bin/subordinate-mcp
    [ -x "$bridge" ] || {
        echo "this AppImage was built without subordinate-mcp" >&2
        exit 127
    }
    exec "$bridge" "$@"
fi

exec "$here/usr/bin/subordinate" "$@"
