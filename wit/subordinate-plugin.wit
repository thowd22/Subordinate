// Subordinate plugin interfaces, version 0.1.0.
//
// Licensed under MIT OR Apache-2.0 so that plugins targeting these interfaces
// may use any licence. See LICENSE-MIT and LICENSE-APACHE.
//
// Every editing operation in Subordinate goes through the one Command API
// (docs/PLAN.md section 3). Plugins are no exception: `command-api` is a host
// import, never a direct handle on the project model, so a plugin edit is an
// ordinary undoable command that the GUI, the CLI and the MCP bridge all see
// identically.

package subordinate:plugin@0.1.0;

/// The value types shared by every host import and plugin export.
///
/// Identifiers are records rather than bare strings so that a `clip-id` cannot
/// be passed where a `track-id` is expected: the generated bindings give each
/// one its own type on both sides of the boundary.
interface types {
    /// One `key`/`value` entry of an error's details map.
    record detail {
        /// The detail's key, unique within one error.
        key: string,
        /// The detail's value, a JSON fragment: WIT has no dynamic JSON type.
        value: string,
    }

    /// A failure crossing the plugin boundary in either direction.
    ///
    /// Mirrors `sub_core::SubError`: a machine-readable code such as
    /// `plugin.command_rejected`, a human message, and optional details for
    /// tooling. Codes are lowercase dot-separated segments of [a-z0-9_], at
    /// least two segments deep, and are never renamed or given a new meaning.
    record error {
        /// Stable machine-readable code, e.g. `plugin.invalid_argument`.
        code: string,
        /// Human-readable, non-localised message.
        message: string,
        /// Structured context for tooling; empty when there is none.
        details: list<detail>,
    }

    /// An exact non-zero ratio, `numerator / denominator`.
    ///
    /// Used for tick rates and frame rates. Both fields are non-zero, and the
    /// fraction is not necessarily reduced: 30000/1001 and 60000/2002 are the
    /// same rate but are not the same value.
    record rational {
        /// The numerator; never zero.
        numerator: u32,
        /// The denominator; never zero.
        denominator: u32,
    }

    /// An exact timeline instant: `value` ticks at `rate` ticks per second.
    ///
    /// Timeline math is rational everywhere in Subordinate; floats never cross
    /// this boundary. The rate is a fraction rather than a single integer
    /// because the rates that matter most are not integers: 23.976 fps is
    /// exactly 24000/1001, and rounding it to a whole number of ticks per
    /// second would drift.
    record rational-time {
        /// The instant, counted in ticks of `rate`. May be negative.
        value: s64,
        /// Ticks per second.
        rate: rational,
    }

    /// A half-open span of the timeline: `[start, start + duration)`.
    record time-range {
        /// The first instant in the span.
        start: rational-time,
        /// The length of the span; never negative.
        duration: rational-time,
    }

    /// Identifies a project open in the host.
    ///
    /// Every identifier below wraps the canonical lowercase hyphenated text of
    /// a UUIDv7, the same form the project file and the Command API use.
    record project-id {
        /// The UUID text, e.g. `018f3c2e-...`.
        value: string,
    }

    /// Identifies a sequence within a project.
    record sequence-id {
        /// The UUID text.
        value: string,
    }

    /// Identifies a track within a sequence.
    record track-id {
        /// The UUID text.
        value: string,
    }

    /// Identifies a clip on a track.
    record clip-id {
        /// The UUID text.
        value: string,
    }

    /// Identifies a marker on a sequence or a clip.
    record marker-id {
        /// The UUID text.
        value: string,
    }

    /// Identifies a media item in a project's bins.
    record media-id {
        /// The UUID text.
        value: string,
    }
}

/// The host side of the Command API: the only way a plugin changes a project,
/// plus the read-only accessors and the logging channel it needs to be useful.
///
/// `run-command` takes the same JSON-RPC method name and `params` object that
/// the local socket server takes, so a plugin and an external agent have
/// exactly the same reach. Each successful call is one undoable command on the
/// host's undo stack.
interface command-api {
    use types.{
        error,
        rational,
        rational-time,
        time-range,
        project-id,
        sequence-id,
        track-id,
        clip-id,
        marker-id,
        media-id,
    };

    /// Severity of a `log` line; maps onto `tracing` levels.
    enum log-level {
        /// Very fine-grained tracing, off by default.
        trace,
        /// Diagnostics useful while developing a plugin.
        debug,
        /// Normal progress a user might want to see.
        info,
        /// Something recoverable that deserves attention.
        warn,
        /// A failure the plugin could not handle.
        error,
    }

    /// What a track carries.
    enum track-kind {
        /// Picture. Video tracks composite top-down.
        video,
        /// Sound. Audio tracks sum in the mixer.
        audio,
    }

    /// A picture size in whole pixels.
    record resolution {
        /// Width in pixels; never zero.
        width: u32,
        /// Height in pixels; never zero.
        height: u32,
    }

    /// Project-level metadata: what is open, and what it contains.
    record project-metadata {
        /// The project's identifier.
        id: project-id,
        /// The project's display name.
        name: string,
        /// The engine revision this metadata was read at. A plugin that
        /// reads, decides and then writes can compare revisions to see
        /// whether the project moved underneath it.
        revision: u64,
        /// Every sequence in the project, in project order.
        sequences: list<sequence-id>,
        /// How many media items the project's bins hold.
        media-count: u32,
    }

    /// Sequence-level metadata; the timebase a plugin must respect.
    record sequence-metadata {
        /// The sequence's identifier.
        id: sequence-id,
        /// The sequence's display name.
        name: string,
        /// Frames per second, exact.
        frame-rate: rational,
        /// The picture size the sequence composites at.
        resolution: resolution,
        /// The audio sample rate in hertz.
        sample-rate: u32,
        /// The end of the last item on the longest track.
        duration: rational-time,
        /// How many tracks the sequence has.
        track-count: u32,
    }

    /// Track-level metadata.
    record track-metadata {
        /// The track's identifier.
        id: track-id,
        /// The track's display name.
        name: string,
        /// Whether the track carries picture or sound.
        kind: track-kind,
        /// Whether the track is excluded from playback and render.
        muted: bool,
        /// Whether the track rejects edits.
        locked: bool,
        /// How many clips sit on the track; gaps and transitions are not
        /// counted.
        clip-count: u32,
        /// The end of the last item on the track.
        duration: rational-time,
    }

    /// One clip on a track, with both of the spans that describe it.
    record clip-metadata {
        /// The clip's identifier.
        id: clip-id,
        /// The clip's display name.
        name: string,
        /// The media item the clip references.
        media: media-id,
        /// The portion of the media the clip uses, in media time.
        source-range: time-range,
        /// Where the clip sits on the track, in sequence time. Placement is
        /// positional: a clip starts where the preceding items end.
        timeline-range: time-range,
    }

    /// One marker on a sequence.
    record marker-metadata {
        /// The marker's identifier.
        id: marker-id,
        /// The marker's display name.
        name: string,
        /// Free-form note; empty when there is none.
        note: string,
        /// The span the marker covers; a point marker has a zero duration.
        marked-range: time-range,
    }

    /// Calls a Command API method that mutates the project.
    ///
    /// `params` and the returned value are JSON documents encoded as UTF-8
    /// strings: the Command API schema is the source of truth for their shape,
    /// and keeping it out of WIT means a new method needs no WIT revision.
    run-command: func(project: project-id, method: string, params: string) -> result<string, error>;

    /// Reads project state without mutating it. Same JSON encoding as
    /// `run-command`, and the same method namespace: only the methods the host
    /// registered as queries are accepted here.
    query: func(project: project-id, method: string, params: string) -> result<string, error>;

    /// Every project currently open in the host, in the order it opened them.
    open-projects: func() -> list<project-id>;

    /// Metadata for one open project.
    project-info: func(project: project-id) -> result<project-metadata, error>;

    /// Metadata for every sequence in `project`, in project order.
    sequences: func(project: project-id) -> result<list<sequence-metadata>, error>;

    /// Metadata for every track of `sequence`, bottom to top.
    tracks: func(project: project-id, sequence: sequence-id) -> result<list<track-metadata>, error>;

    /// Every clip on `track`, in track order. Gaps and transitions are not
    /// listed; `timeline-range` is where each clip actually lands.
    clips: func(project: project-id, sequence: sequence-id, track: track-id) -> result<list<clip-metadata>, error>;

    /// Every marker on `sequence`, in the order the sequence holds them.
    markers: func(project: project-id, sequence: sequence-id) -> result<list<marker-metadata>, error>;

    /// The playhead position in `project`, for commands that act relative to it.
    playhead: func(project: project-id) -> result<rational-time, error>;

    /// Emits a line to the host's tracing subscriber, tagged with the plugin id.
    log: func(level: log-level, message: string);
}

/// The simplest plugin world: a plugin that registers nothing and just runs a
/// command against a project when the host asks it to.
///
/// Later worlds (effect, audio-effect, importer, exporter, analyzer, mcp-tools,
/// and the richer command world with menu and shortcut registration) build on
/// this same `command-api` import.
world command {
    use types.{error, project-id};

    import command-api;

    /// Runs the plugin against `project`. `args` is a JSON object, the same
    /// encoding the Command API uses for parameters; so is the returned value.
    export run: func(project: project-id, args: string) -> result<string, error>;
}

/// The value types of a GPU effect: its parameter schema, the WGSL it runs and
/// the frames the optional CPU path sees.
///
/// A WASM guest never touches the GPU (decision-6). An effect plugin therefore
/// *declares* itself — a list of parameters plus one WGSL source — and the core
/// compiles the shader, builds the uniform buffer from the declared parameters
/// and runs it in the compositor. The plugin's own code runs once, at describe
/// time, not per frame.
interface effect-types {
    use types.{rational-time};

    /// An RGBA colour, each channel in `0.0..=1.0`.
    ///
    /// Linear, not gamma-encoded, and untagged: the MVP composites in
    /// Rec.709 (decision-3), so a colour parameter reaches the shader as
    /// written with no conversion.
    record color {
        /// Red.
        r: f32,
        /// Green.
        g: f32,
        /// Blue.
        b: f32,
        /// Alpha, where 0.0 is fully transparent.
        a: f32,
    }

    /// A continuous parameter, e.g. an exposure stop or a mix amount.
    record float-param {
        /// Smallest accepted value, inclusive.
        min: f32,
        /// Largest accepted value, inclusive; never below `min`.
        max: f32,
        /// The value the host uses until the user changes it; within range.
        default: f32,
        /// Increment a stepped control snaps to; none means continuous.
        step: option<f32>,
    }

    /// A whole-number parameter, e.g. a sample count.
    record int-param {
        /// Smallest accepted value, inclusive.
        min: s32,
        /// Largest accepted value, inclusive; never below `min`.
        max: s32,
        /// The value the host uses until the user changes it; within range.
        default: s32,
    }

    /// An on/off parameter. It reaches the shader as `0` or `1`.
    record bool-param {
        /// The value the host uses until the user changes it.
        default: bool,
    }

    /// A colour parameter, edited with a colour picker.
    record color-param {
        /// The value the host uses until the user changes it.
        default: color,
    }

    /// One choice of an `enum-param`.
    record enum-variant {
        /// Stable machine-readable key, e.g. `luma`. Never renamed: a saved
        /// project stores this, not the label or the index.
        id: string,
        /// Human-readable label for the inspector.
        label: string,
    }

    /// A closed set of choices, e.g. a blend mode.
    record enum-param {
        /// The choices, in the order the inspector lists them; never empty.
        variants: list<enum-variant>,
        /// Index into `variants` of the default choice; always in bounds.
        default: u32,
    }

    /// Which kind of value a parameter holds, with its range and default.
    ///
    /// `boolean` rather than `bool` only because `bool` is a WIT keyword; it
    /// is the flag case the SDK and the inspector call a bool parameter.
    variant param-kind {
        /// A continuous value.
        float(float-param),
        /// A whole number.
        int(int-param),
        /// A flag.
        boolean(bool-param),
        /// An RGBA colour.
        color(color-param),
        /// One of a closed set of choices.
        choice(enum-param),
    }

    /// One parameter of an effect: what the inspector shows and what the
    /// shader reads.
    record param-desc {
        /// Stable machine-readable key, e.g. `exposure`. It is the field name
        /// the host gives this parameter in the shader's uniform struct, and
        /// the key a project file stores, so it is never renamed. Lowercase
        /// `[a-z0-9_]`, starting with a letter.
        id: string,
        /// Human-readable label for the inspector.
        label: string,
        /// One-line explanation for tooltips; empty when there is none.
        doc: string,
        /// The value's type, range and default.
        kind: param-kind,
    }

    /// A parameter's current value. The case always matches the `param-kind`
    /// the parameter was declared with.
    variant param-value {
        /// A continuous value, within the declared range.
        float(f32),
        /// A whole number, within the declared range.
        int(s32),
        /// A flag.
        boolean(bool),
        /// An RGBA colour.
        color(color),
        /// Index into the declared `variants`; always in bounds.
        choice(u32),
    }

    /// One parameter's value, keyed by `param-desc.id`.
    record param-binding {
        /// The parameter's `id`.
        id: string,
        /// Its value for this invocation.
        value: param-value,
    }

    /// How the bytes of a `frame` are laid out.
    enum pixel-format {
        /// Eight bits per channel, R, G, B then A, linear.
        rgba8-unorm,
        /// Eight bits per channel, R, G, B then A, sRGB-encoded.
        rgba8-unorm-srgb,
    }

    /// One picture crossing the boundary to the optional CPU path.
    record frame {
        /// Width in pixels; never zero.
        width: u32,
        /// Height in pixels; never zero.
        height: u32,
        /// Bytes per row, which may exceed `width` times the pixel size.
        stride: u32,
        /// How `pixels` is laid out.
        format: pixel-format,
        /// The instant this frame sits at, exact: effect timing is rational
        /// like the rest of the timeline, never seconds as a float.
        time: rational-time,
        /// The pixels, `stride` times `height` bytes.
        pixels: list<u8>,
    }

    /// What a plugin declares about the one effect it provides.
    ///
    /// `shader` is WGSL source the host compiles and caches by hash. It
    /// declares a fragment entry point named `entry` that samples the input
    /// picture and reads the declared parameters from the uniform struct the
    /// host builds from `params`; the host owns every binding, so the shader
    /// never allocates or binds resources itself.
    record effect-desc {
        /// The effect's parameters, in the order the inspector shows them.
        /// Empty for an effect that takes none. Every `id` is unique.
        params: list<param-desc>,
        /// WGSL source for the effect.
        shader: string,
        /// Name of the fragment entry point in `shader`, e.g. `fs_main`.
        entry: string,
    }
}

/// A GPU effect: the plugin declares parameters and a WGSL shader, the core
/// compiles and runs them (decision-6).
///
/// `describe` is called once when the host loads the plugin, and again after a
/// hot reload. It takes no project, because an effect declaration is static:
/// per-clip parameter values live in the project model and are edited through
/// ordinary undoable commands, not by the plugin.
world effect {
    use effect-types.{effect-desc};

    import command-api;

    /// Declares this plugin's effect. Called at load time, not per frame.
    export describe: func() -> effect-desc;
}

/// The `effect` world plus the optional CPU path.
///
/// A plugin exports `process-cpu` by targeting this world instead of `effect`;
/// a plugin that only ships a shader targets `effect` and exports nothing else.
/// Both are `subordinate:plugin@0.1.0` and the host accepts either.
///
/// **`process-cpu` is slow.** It copies a whole frame into the sandbox, runs a
/// per-pixel loop in WASM and copies the result back, so it is for small
/// buffers only — thumbnails, analysis passes, unit-test fixtures — and never
/// for playback or export at picture size (docs/PLAN.md section 6, decision-6).
/// When a plugin exports it, the host still prefers `shader`; it falls back to
/// `process-cpu` only where no GPU is available or the buffer is small enough
/// that the round trip is cheaper than a render pass.
world effect-cpu {
    include effect;

    use effect-types.{frame, param-binding};
    use types.{error};

    /// Processes one small frame on the CPU. `params` carries a value for
    /// every parameter `describe` declared, in declaration order. The returned
    /// frame keeps the input's width, height and format.
    export process-cpu: func(frame: frame, params: list<param-binding>) -> result<frame, error>;
}
