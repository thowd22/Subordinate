// Subordinate plugin interfaces, version 0.1.0.
//
// Licensed under MIT OR Apache-2.0 so that plugins targeting these interfaces
// may use any licence. See LICENSE-MIT and LICENSE-APACHE.
//
// Every editing operation in Subordinate goes through the one Command API
// (docs/PLAN.md section 3). Plugins are no exception: `command-api` is a host
// import, never a direct handle on the project model, so a plugin edit is an
// ordinary undoable command that the GUI, the CLI and the MCP bridge all see
// identically.

package subordinate:plugin@0.1.0;

/// The value types shared by every host import and plugin export.
///
/// Identifiers are records rather than bare strings so that a `clip-id` cannot
/// be passed where a `track-id` is expected: the generated bindings give each
/// one its own type on both sides of the boundary.
interface types {
    /// One `key`/`value` entry of an error's details map.
    record detail {
        /// The detail's key, unique within one error.
        key: string,
        /// The detail's value, a JSON fragment: WIT has no dynamic JSON type.
        value: string,
    }

    /// A failure crossing the plugin boundary in either direction.
    ///
    /// Mirrors `sub_core::SubError`: a machine-readable code such as
    /// `plugin.command_rejected`, a human message, and optional details for
    /// tooling. Codes are lowercase dot-separated segments of [a-z0-9_], at
    /// least two segments deep, and are never renamed or given a new meaning.
    record error {
        /// Stable machine-readable code, e.g. `plugin.invalid_argument`.
        code: string,
        /// Human-readable, non-localised message.
        message: string,
        /// Structured context for tooling; empty when there is none.
        details: list<detail>,
    }

    /// An exact non-zero ratio, `numerator / denominator`.
    ///
    /// Used for tick rates and frame rates. Both fields are non-zero, and the
    /// fraction is not necessarily reduced: 30000/1001 and 60000/2002 are the
    /// same rate but are not the same value.
    record rational {
        /// The numerator; never zero.
        numerator: u32,
        /// The denominator; never zero.
        denominator: u32,
    }

    /// An exact timeline instant: `value` ticks at `rate` ticks per second.
    ///
    /// Timeline math is rational everywhere in Subordinate; floats never cross
    /// this boundary. The rate is a fraction rather than a single integer
    /// because the rates that matter most are not integers: 23.976 fps is
    /// exactly 24000/1001, and rounding it to a whole number of ticks per
    /// second would drift.
    record rational-time {
        /// The instant, counted in ticks of `rate`. May be negative.
        value: s64,
        /// Ticks per second.
        rate: rational,
    }

    /// A half-open span of the timeline: `[start, start + duration)`.
    record time-range {
        /// The first instant in the span.
        start: rational-time,
        /// The length of the span; never negative.
        duration: rational-time,
    }

    /// Identifies a project open in the host.
    ///
    /// Every identifier below wraps the canonical lowercase hyphenated text of
    /// a UUIDv7, the same form the project file and the Command API use.
    record project-id {
        /// The UUID text, e.g. `018f3c2e-...`.
        value: string,
    }

    /// Identifies a sequence within a project.
    record sequence-id {
        /// The UUID text.
        value: string,
    }

    /// Identifies a track within a sequence.
    record track-id {
        /// The UUID text.
        value: string,
    }

    /// Identifies a clip on a track.
    record clip-id {
        /// The UUID text.
        value: string,
    }

    /// Identifies a marker on a sequence or a clip.
    record marker-id {
        /// The UUID text.
        value: string,
    }

    /// Identifies a media item in a project's bins.
    record media-id {
        /// The UUID text.
        value: string,
    }
}

/// The host side of the Command API: the only way a plugin changes a project,
/// plus the read-only accessors and the logging channel it needs to be useful.
///
/// `run-command` takes the same JSON-RPC method name and `params` object that
/// the local socket server takes, so a plugin and an external agent have
/// exactly the same reach. Each successful call is one undoable command on the
/// host's undo stack.
interface command-api {
    use types.{
        error,
        rational,
        rational-time,
        time-range,
        project-id,
        sequence-id,
        track-id,
        clip-id,
        marker-id,
        media-id,
    };

    /// Severity of a `log` line; maps onto `tracing` levels.
    enum log-level {
        /// Very fine-grained tracing, off by default.
        trace,
        /// Diagnostics useful while developing a plugin.
        debug,
        /// Normal progress a user might want to see.
        info,
        /// Something recoverable that deserves attention.
        warn,
        /// A failure the plugin could not handle.
        error,
    }

    /// What a track carries.
    enum track-kind {
        /// Picture. Video tracks composite top-down.
        video,
        /// Sound. Audio tracks sum in the mixer.
        audio,
    }

    /// A picture size in whole pixels.
    record resolution {
        /// Width in pixels; never zero.
        width: u32,
        /// Height in pixels; never zero.
        height: u32,
    }

    /// Project-level metadata: what is open, and what it contains.
    record project-metadata {
        /// The project's identifier.
        id: project-id,
        /// The project's display name.
        name: string,
        /// The engine revision this metadata was read at. A plugin that
        /// reads, decides and then writes can compare revisions to see
        /// whether the project moved underneath it.
        revision: u64,
        /// Every sequence in the project, in project order.
        sequences: list<sequence-id>,
        /// How many media items the project's bins hold.
        media-count: u32,
    }

    /// Sequence-level metadata; the timebase a plugin must respect.
    record sequence-metadata {
        /// The sequence's identifier.
        id: sequence-id,
        /// The sequence's display name.
        name: string,
        /// Frames per second, exact.
        frame-rate: rational,
        /// The picture size the sequence composites at.
        resolution: resolution,
        /// The audio sample rate in hertz.
        sample-rate: u32,
        /// The end of the last item on the longest track.
        duration: rational-time,
        /// How many tracks the sequence has.
        track-count: u32,
    }

    /// Track-level metadata.
    record track-metadata {
        /// The track's identifier.
        id: track-id,
        /// The track's display name.
        name: string,
        /// Whether the track carries picture or sound.
        kind: track-kind,
        /// Whether the track is excluded from playback and render.
        muted: bool,
        /// Whether the track rejects edits.
        locked: bool,
        /// How many clips sit on the track; gaps and transitions are not
        /// counted.
        clip-count: u32,
        /// The end of the last item on the track.
        duration: rational-time,
    }

    /// One clip on a track, with both of the spans that describe it.
    record clip-metadata {
        /// The clip's identifier.
        id: clip-id,
        /// The clip's display name.
        name: string,
        /// The media item the clip references.
        media: media-id,
        /// The portion of the media the clip uses, in media time.
        source-range: time-range,
        /// Where the clip sits on the track, in sequence time. Placement is
        /// positional: a clip starts where the preceding items end.
        timeline-range: time-range,
    }

    /// One marker on a sequence.
    record marker-metadata {
        /// The marker's identifier.
        id: marker-id,
        /// The marker's display name.
        name: string,
        /// Free-form note; empty when there is none.
        note: string,
        /// The span the marker covers; a point marker has a zero duration.
        marked-range: time-range,
    }

    /// Calls a Command API method that mutates the project.
    ///
    /// `params` and the returned value are JSON documents encoded as UTF-8
    /// strings: the Command API schema is the source of truth for their shape,
    /// and keeping it out of WIT means a new method needs no WIT revision.
    run-command: func(project: project-id, method: string, params: string) -> result<string, error>;

    /// Reads project state without mutating it. Same JSON encoding as
    /// `run-command`, and the same method namespace: only the methods the host
    /// registered as queries are accepted here.
    query: func(project: project-id, method: string, params: string) -> result<string, error>;

    /// Every project currently open in the host, in the order it opened them.
    open-projects: func() -> list<project-id>;

    /// Metadata for one open project.
    project-info: func(project: project-id) -> result<project-metadata, error>;

    /// Metadata for every sequence in `project`, in project order.
    sequences: func(project: project-id) -> result<list<sequence-metadata>, error>;

    /// Metadata for every track of `sequence`, bottom to top.
    tracks: func(project: project-id, sequence: sequence-id) -> result<list<track-metadata>, error>;

    /// Every clip on `track`, in track order. Gaps and transitions are not
    /// listed; `timeline-range` is where each clip actually lands.
    clips: func(project: project-id, sequence: sequence-id, track: track-id) -> result<list<clip-metadata>, error>;

    /// Every marker on `sequence`, in the order the sequence holds them.
    markers: func(project: project-id, sequence: sequence-id) -> result<list<marker-metadata>, error>;

    /// The playhead position in `project`, for commands that act relative to it.
    playhead: func(project: project-id) -> result<rational-time, error>;

    /// Emits a line to the host's tracing subscriber, tagged with the plugin id.
    log: func(level: log-level, message: string);
}

/// The simplest plugin world: a plugin that registers nothing and just runs a
/// command against a project when the host asks it to.
///
/// Later worlds (effect, audio-effect, importer, exporter, analyzer, mcp-tools,
/// and the richer command world with menu and shortcut registration) build on
/// this same `command-api` import.
world command {
    use types.{error, project-id};

    import command-api;

    /// Runs the plugin against `project`. `args` is a JSON object, the same
    /// encoding the Command API uses for parameters; so is the returned value.
    export run: func(project: project-id, args: string) -> result<string, error>;
}

/// The value types of a GPU effect: its parameter schema, the WGSL it runs and
/// the frames the optional CPU path sees.
///
/// A WASM guest never touches the GPU (decision-6). An effect plugin therefore
/// *declares* itself — a list of parameters plus one WGSL source — and the core
/// compiles the shader, builds the uniform buffer from the declared parameters
/// and runs it in the compositor. The plugin's own code runs once, at describe
/// time, not per frame.
interface effect-types {
    use types.{rational-time};

    /// An RGBA colour, each channel in `0.0..=1.0`.
    ///
    /// Linear, not gamma-encoded, and untagged: the MVP composites in
    /// Rec.709 (decision-3), so a colour parameter reaches the shader as
    /// written with no conversion.
    record color {
        /// Red.
        r: f32,
        /// Green.
        g: f32,
        /// Blue.
        b: f32,
        /// Alpha, where 0.0 is fully transparent.
        a: f32,
    }

    /// A continuous parameter, e.g. an exposure stop or a mix amount.
    record float-param {
        /// Smallest accepted value, inclusive.
        min: f32,
        /// Largest accepted value, inclusive; never below `min`.
        max: f32,
        /// The value the host uses until the user changes it; within range.
        default: f32,
        /// Increment a stepped control snaps to; none means continuous.
        step: option<f32>,
    }

    /// A whole-number parameter, e.g. a sample count.
    record int-param {
        /// Smallest accepted value, inclusive.
        min: s32,
        /// Largest accepted value, inclusive; never below `min`.
        max: s32,
        /// The value the host uses until the user changes it; within range.
        default: s32,
    }

    /// An on/off parameter. It reaches the shader as `0` or `1`.
    record bool-param {
        /// The value the host uses until the user changes it.
        default: bool,
    }

    /// A colour parameter, edited with a colour picker.
    record color-param {
        /// The value the host uses until the user changes it.
        default: color,
    }

    /// One choice of an `enum-param`.
    record enum-variant {
        /// Stable machine-readable key, e.g. `luma`. Never renamed: a saved
        /// project stores this, not the label or the index.
        id: string,
        /// Human-readable label for the inspector.
        label: string,
    }

    /// A closed set of choices, e.g. a blend mode.
    record enum-param {
        /// The choices, in the order the inspector lists them; never empty.
        variants: list<enum-variant>,
        /// Index into `variants` of the default choice; always in bounds.
        default: u32,
    }

    /// Which kind of value a parameter holds, with its range and default.
    ///
    /// `boolean` rather than `bool` only because `bool` is a WIT keyword; it
    /// is the flag case the SDK and the inspector call a bool parameter.
    variant param-kind {
        /// A continuous value.
        float(float-param),
        /// A whole number.
        int(int-param),
        /// A flag.
        boolean(bool-param),
        /// An RGBA colour.
        color(color-param),
        /// One of a closed set of choices.
        choice(enum-param),
    }

    /// One parameter of an effect: what the inspector shows and what the
    /// shader reads.
    record param-desc {
        /// Stable machine-readable key, e.g. `exposure`. It is the field name
        /// the host gives this parameter in the shader's uniform struct, and
        /// the key a project file stores, so it is never renamed. Lowercase
        /// `[a-z0-9_]`, starting with a letter.
        id: string,
        /// Human-readable label for the inspector.
        label: string,
        /// One-line explanation for tooltips; empty when there is none.
        doc: string,
        /// The value's type, range and default.
        kind: param-kind,
    }

    /// A parameter's current value. The case always matches the `param-kind`
    /// the parameter was declared with.
    variant param-value {
        /// A continuous value, within the declared range.
        float(f32),
        /// A whole number, within the declared range.
        int(s32),
        /// A flag.
        boolean(bool),
        /// An RGBA colour.
        color(color),
        /// Index into the declared `variants`; always in bounds.
        choice(u32),
    }

    /// One parameter's value, keyed by `param-desc.id`.
    record param-binding {
        /// The parameter's `id`.
        id: string,
        /// Its value for this invocation.
        value: param-value,
    }

    /// How the bytes of a `frame` are laid out.
    enum pixel-format {
        /// Eight bits per channel, R, G, B then A, linear.
        rgba8-unorm,
        /// Eight bits per channel, R, G, B then A, sRGB-encoded.
        rgba8-unorm-srgb,
    }

    /// One picture crossing the boundary to the optional CPU path.
    record frame {
        /// Width in pixels; never zero.
        width: u32,
        /// Height in pixels; never zero.
        height: u32,
        /// Bytes per row, which may exceed `width` times the pixel size.
        stride: u32,
        /// How `pixels` is laid out.
        format: pixel-format,
        /// The instant this frame sits at, exact: effect timing is rational
        /// like the rest of the timeline, never seconds as a float.
        time: rational-time,
        /// The pixels, `stride` times `height` bytes.
        pixels: list<u8>,
    }

    /// What a plugin declares about the one effect it provides.
    ///
    /// `shader` is WGSL source the host compiles and caches by hash. It
    /// declares a fragment entry point named `entry` that samples the input
    /// picture and reads the declared parameters from the uniform struct the
    /// host builds from `params`; the host owns every binding, so the shader
    /// never allocates or binds resources itself.
    record effect-desc {
        /// The effect's parameters, in the order the inspector shows them.
        /// Empty for an effect that takes none. Every `id` is unique.
        params: list<param-desc>,
        /// WGSL source for the effect.
        shader: string,
        /// Name of the fragment entry point in `shader`, e.g. `fs_main`.
        entry: string,
    }
}

/// A GPU effect: the plugin declares parameters and a WGSL shader, the core
/// compiles and runs them (decision-6).
///
/// `describe` is called once when the host loads the plugin, and again after a
/// hot reload. It takes no project, because an effect declaration is static:
/// per-clip parameter values live in the project model and are edited through
/// ordinary undoable commands, not by the plugin.
world effect {
    use effect-types.{effect-desc};

    import command-api;

    /// Declares this plugin's effect. Called at load time, not per frame.
    export describe: func() -> effect-desc;
}

/// The `effect` world plus the optional CPU path.
///
/// A plugin exports `process-cpu` by targeting this world instead of `effect`;
/// a plugin that only ships a shader targets `effect` and exports nothing else.
/// Both are `subordinate:plugin@0.1.0` and the host accepts either.
///
/// **`process-cpu` is slow.** It copies a whole frame into the sandbox, runs a
/// per-pixel loop in WASM and copies the result back, so it is for small
/// buffers only — thumbnails, analysis passes, unit-test fixtures — and never
/// for playback or export at picture size (docs/PLAN.md section 6, decision-6).
/// When a plugin exports it, the host still prefers `shader`; it falls back to
/// `process-cpu` only where no GPU is available or the buffer is small enough
/// that the round trip is cheaper than a render pass.
world effect-cpu {
    include effect;

    use effect-types.{frame, param-binding};
    use types.{error};

    /// Processes one small frame on the CPU. `params` carries a value for
    /// every parameter `describe` declared, in declaration order. The returned
    /// frame keeps the input's width, height and format.
    export process-cpu: func(frame: frame, params: list<param-binding>) -> result<frame, error>;
}

/// What a plugin contributes to the host's menus and keyboard map, and what it
/// is handed back when one of those entries is chosen.
///
/// Registration is data, not a callback: the host asks a plugin what commands
/// it has once, at load time, and from then on the Plugins menu and the
/// shortcut registry are answerable without instantiating anything.
interface command-menu {
    use types.{project-id};

    /// One command a plugin contributes.
    record command-desc {
        /// Stable, plugin-local identifier, e.g. `cut-silence`. The host
        /// qualifies it with the plugin id, so two plugins may use the same
        /// one. Lowercase [a-z0-9_-] segments separated by `.`; it is the name
        /// the host passes back to `run`, and renaming it breaks every keymap
        /// entry naming it.
        id: string,
        /// The human-readable name shown in the Plugins menu.
        title: string,
        /// The chord the plugin would like, e.g. `Ctrl+Shift+K`, written the
        /// way `keymap.toml` writes one. A request, not a claim: the host's own
        /// actions and the user's keymap win, and a rejected chord leaves the
        /// command reachable from the menu.
        shortcut: option<string>,
    }

    /// What one invocation of a plugin command acts on.
    ///
    /// The project is named rather than handed over: a plugin still reaches it
    /// only through `command-api`, so a command run is an ordinary sequence of
    /// undoable commands that the host groups into one undo step.
    record command-context {
        /// The project the command was invoked on.
        project: project-id,
        /// The invocation's arguments as a JSON object, the same encoding the
        /// Command API uses for parameters. `{}` when there are none.
        args: string,
    }
}

/// The command world with menu and shortcut registration: a plugin that
/// contributes several named commands rather than one anonymous entry point.
///
/// `commands` is asked once when the plugin loads, and its answers become
/// entries in the Plugins menu and requests on the shortcut registry. `run` is
/// then called with the id of the entry the user chose. Everything it edits
/// goes through the `command-api` import, and the host opens one undo group
/// around the whole call, so a plugin command is one step on the undo stack no
/// matter how many primitives it applies.
world commands {
    use types.{error};
    use command-menu.{command-desc, command-context};

    import command-api;

    /// Every command this plugin contributes, in the order the menu lists them.
    export commands: func() -> list<command-desc>;

    /// Runs the command `id` names. The returned value is a JSON document, as
    /// is `context.args`.
    export run: func(id: string, context: command-context) -> result<string, error>;
}

/// The descriptor a plugin publishes for each MCP tool it contributes.
interface mcp {
    /// One tool a plugin adds to the agent surface (docs/PLAN.md §6.2, §7).
    ///
    /// These are the same three fields an MCP client sees, so the bridge
    /// forwards a descriptor rather than rebuilding one. The plugin's manifest
    /// declares the same tools; the host checks the two agree before it offers
    /// any of them, and validates a call's arguments against `json-schema`
    /// before the call reaches the plugin.
    record tool-desc {
        /// The tool's plugin-local name, e.g. `cut_silence`. Lowercase ASCII
        /// letters, digits and underscores. The bridge prefixes it with the
        /// plugin id, so a plugin never namespaces it itself.
        name: string,
        /// One line telling an agent what the tool does and when to reach for
        /// it. This is the text the agent chooses on, so it is prose rather
        /// than a signature.
        description: string,
        /// The tool's argument schema: a JSON Schema object encoded as UTF-8.
        /// It must be self-contained, because the host resolves no remote or
        /// file references while validating.
        json-schema: string,
    }
}

/// A plugin that contributes MCP tools of its own.
///
/// The host forwards each tool to the MCP bridge under the plugin's id, so an
/// agent sees plugin tools and built-in tools in one list. A tool that changes
/// the project still goes through `command-api`, so it stays one undoable
/// command like any other edit.
world mcp-tools {
    use types.{error};
    use mcp.{tool-desc};

    import command-api;

    /// Every tool the plugin contributes, in the order an agent should see
    /// them. Called on load and again after a hot reload; the host compares the
    /// result with the manifest's declarations and refuses any tool the
    /// manifest does not declare.
    export tools: func() -> list<tool-desc>;

    /// Runs one of the plugin's tools. `name` is the plugin-local name from
    /// `tools`, without the plugin-id prefix, and `args-json` is a JSON object
    /// the host has already validated against that tool's schema. The result is
    /// the tool's JSON output.
    export call: func(name: string, args-json: string) -> result<string, error>;
}

/// Block-based audio processing: the value types an `audio-effect` plugin
/// describes itself with and is driven by (docs/PLAN.md section 6.2).
///
/// Audio is the one place in Subordinate where floats are the right type:
/// samples are `f32` and a parameter is a scalar the DSP applies. Timeline math
/// stays rational and is not part of this interface — an audio effect is handed
/// a block and a sample rate, never a timeline instant.
interface audio {
    /// A parameter's unit, so a host can label and scale a control without
    /// knowing the plugin.
    enum param-unit {
        /// A bare multiplier or ratio.
        linear,
        /// Decibels, full scale.
        decibel,
        /// Frequency in hertz.
        hertz,
        /// A duration in seconds.
        seconds,
        /// A percentage, 0 to 100.
        percent,
    }

    /// One parameter a plugin accepts, as `describe` reports it.
    ///
    /// `minimum <= default <= maximum`, and the host clamps a value into that
    /// range before it reaches `process`, so a plugin never has to.
    record param-descriptor {
        /// Stable machine-readable name, e.g. `gain-db`. Lowercase, hyphenated,
        /// unique within one plugin, and never renamed once published.
        name: string,
        /// Human-readable label for the control.
        label: string,
        /// What the value means.
        unit: param-unit,
        /// Smallest accepted value.
        minimum: f32,
        /// Largest accepted value.
        maximum: f32,
        /// The value the host uses until a user changes it.
        default: f32,
    }

    /// One parameter value for one block, as the host passes it to `process`.
    record param {
        /// The descriptor's `name`.
        name: string,
        /// The value, already clamped to the descriptor's range.
        value: f32,
    }

    /// What a plugin says about itself when the host loads it.
    record effect-description {
        /// Stable machine-readable identifier, e.g. `com.example.gain`.
        id: string,
        /// Human-readable name for the effect.
        name: string,
        /// Every parameter the effect accepts, in the order a UI should show
        /// them.
        params: list<param-descriptor>,
        /// The largest block, in frames per channel, the effect can process in
        /// one call. Zero means any size.
        max-block-frames: u32,
        /// The share of one block's wall-clock duration the effect claims, in
        /// percent of real time: 25 means a 10 ms block should take at most
        /// 2.5 ms. The host treats this as a hint bounded by its own policy and
        /// bypasses the effect after repeated overruns of whichever budget is
        /// smaller.
        budget-percent: u32,
    }
}

/// A block-based audio effect: gain, EQ, and anything else that maps a buffer
/// of samples onto a buffer of samples.
///
/// The host calls `process` from an engine worker, never from the real-time
/// audio callback: the callback may not allocate or block, and crossing into
/// WebAssembly does both. Processing is still held to a real-time budget so a
/// slow plugin cannot starve playback — the host times every block and, after
/// repeated overruns, bypasses the plugin and passes the audio through
/// untouched.
world audio-effect {
    use types.{error};
    use audio.{effect-description, param};

    import command-api;

    /// Reports the effect's identity, parameters and budget claim. Called when
    /// the host loads the plugin; it must not depend on any prior call.
    export describe: func() -> effect-description;

    /// Processes one block of interleaved samples.
    ///
    /// `block` holds `channels` samples per frame, interleaved, so its length
    /// is always a whole multiple of `channels`. `rate` is the sample rate in
    /// hertz. `params` carries one entry per parameter the plugin described,
    /// already clamped to its range.
    ///
    /// The returned buffer has exactly the length and channel interleaving of
    /// `block`. Returning an error, returning a different length, and exceeding
    /// the time budget all count the same way: the host drops the block's
    /// output, passes the input through, and bypasses the plugin once the
    /// faults repeat.
    export process: func(block: list<f32>, channels: u32, rate: u32, params: list<param>) -> result<list<f32>, error>;
}

/// Turning a file into media items or whole sequences.
///
/// An importer never edits the project itself: it parses a path and hands the
/// host a description of what it found. The host applies that description
/// through the Command API, so an import is an ordinary undoable command and
/// the identifiers of everything created stay the host's to mint.
///
/// Time is exact throughout: a source range is a `time-range`, a gap is a
/// `rational-time`, and a sequence declares its `frame-rate` as a fraction.
interface importer-api {
    use types.{error, rational, rational-time, time-range, media-id};
    use command-api.{track-kind, resolution};

    /// A media file the importer found, described well enough for the host to
    /// file it in a bin.
    record media-spec {
        /// Where the file lives, relative to the project folder, with `/` as
        /// the separator. Never absolute and never containing `..`.
        path: string,
        /// Display name for the bin. Empty means "use the file name".
        name: string,
    }

    /// Which media item a clip plays.
    ///
    /// A sequence produced by the same import usually refers to media the same
    /// import produced, which has no identifier yet; `existing` is for a file
    /// already in the project's bins.
    variant media-ref {
        /// A zero-based index into the `media` entries of this same import.
        imported(u32),
        /// A media item already in the project.
        existing(media-id),
    }

    /// One marker, on a sequence or on a clip.
    record marker-spec {
        /// Display name shown on the ruler.
        name: string,
        /// Free-form note; empty when there is none.
        note: string,
        /// The span covered; a point marker has a zero duration.
        marked-range: time-range,
    }

    /// One clip on a track.
    record clip-spec {
        /// Display name for the timeline rectangle. Empty means "use the
        /// media item's name".
        name: string,
        /// The media the clip plays.
        media: media-ref,
        /// The portion of that media used, in media time.
        source-range: time-range,
        /// Markers anchored to the clip, in source time.
        markers: list<marker-spec>,
    }

    /// A blend across the cut between the items either side of it. Crossfade
    /// is the only transition the MVP models.
    record transition-spec {
        /// How far the blend reaches back into the outgoing item.
        in-offset: rational-time,
        /// How far it reaches forward into the incoming item.
        out-offset: rational-time,
    }

    /// One entry in a track's ordered child list.
    variant track-item-spec {
        /// A piece of media.
        clip(clip-spec),
        /// Empty time of this length.
        gap(rational-time),
        /// A blend across the neighbouring cut; it consumes no track time of
        /// its own.
        transition(transition-spec),
    }

    /// One lane of a sequence.
    record track-spec {
        /// Display name for the track header, such as `V1`.
        name: string,
        /// Whether the lane carries picture or sound.
        kind: track-kind,
        /// The items, in playback order. Placement is positional: an item
        /// starts where the preceding ones end.
        items: list<track-item-spec>,
    }

    /// A whole sequence: timebase, lanes and markers.
    record sequence-spec {
        /// Display name for the sequence tab.
        name: string,
        /// Frames per second, exact.
        frame-rate: rational,
        /// The picture size the sequence composites at.
        resolution: resolution,
        /// The audio sample rate in hertz; never zero.
        sample-rate: u32,
        /// The lanes, bottom to top.
        tracks: list<track-spec>,
        /// Markers on the sequence itself, in sequence time.
        markers: list<marker-spec>,
    }

    /// One thing an import produced.
    variant media-or-sequence-spec {
        /// A media file for the bin.
        media(media-spec),
        /// A sequence for the project. Its clips may refer to media entries
        /// earlier in the same result list.
        sequence(sequence-spec),
    }

    /// The lowercase file extensions this importer handles, without the dot,
    /// e.g. `["otio", "edl"]`. The host uses them to build file dialog filters
    /// and to choose an importer for a path.
    supported-extensions: func() -> list<string>;

    /// Reads `path` and describes what it holds.
    ///
    /// `path` is inside a folder the plugin's manifest granted it read access
    /// to; anything else is refused by the host before this is called. The
    /// importer only reads: the host applies the result through the Command
    /// API, filing media in the bin and inserting sequences, as one undoable
    /// step per item.
    %import: func(path: string) -> result<list<media-or-sequence-spec>, error>;
}

/// Encoder presets and custom export targets.
///
/// An exporter contributes named presets to the export panel and may take an
/// action once the host has written the file: upload it, write a sidecar,
/// notify something. Encoding itself stays in the host.
interface exporter-api {
    use types.{error, rational};

    /// One setting of a preset, as a `key`/`value` pair.
    ///
    /// The value is a JSON fragment, the same encoding `run-command` uses for
    /// parameters: WIT has no dynamic JSON type, and keeping the settings open
    /// means a new encoder option needs no WIT revision.
    record preset-setting {
        /// The setting's key, unique within one preset.
        key: string,
        /// The setting's value, a JSON fragment.
        value: string,
    }

    /// A preset the export panel offers.
    record preset-desc {
        /// Stable identifier, unique within the plugin, in the same lowercase
        /// dot-separated form as an error code, e.g. `youtube.1080p`. Never
        /// renamed once shipped: the project file remembers it.
        id: string,
        /// Display name for the export panel.
        name: string,
        /// One-line description of what the preset produces; empty when there
        /// is none.
        description: string,
        /// The container extension the preset writes, without the dot, e.g.
        /// `mp4`.
        container: string,
        /// Frames per second the preset encodes at, exact. Absent means "use
        /// the sequence's own rate".
        frame-rate: option<rational>,
        /// Encoder settings, applied over the host's defaults for the
        /// container.
        settings: list<preset-setting>,
    }

    /// Every preset this exporter offers, in the order the panel lists them.
    presets: func() -> list<preset-desc>;

    /// Called once the host has finished writing `path`.
    ///
    /// The hook is optional in effect: an exporter that only contributes
    /// presets returns `ok` without doing anything, and the SDK's default
    /// implementation does exactly that. `path` is the file the host wrote,
    /// inside a folder the manifest granted write access to.
    post-export: func(path: string) -> result<_, error>;
}

/// A plugin that turns files into media items and sequences.
///
/// It imports `command-api` like every other world, both because reading the
/// project tells it what timebase to describe things in and because an
/// importer may want to run commands of its own; the host applies the returned
/// specs itself.
world importer {
    import command-api;

    export importer-api;
}

/// A plugin that contributes export presets and post-export actions.
world exporter {
    import command-api;

    export exporter-api;
}
